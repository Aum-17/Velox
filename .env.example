# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Postgres connection string (Vercel → Storage → Neon gives you this automatically)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Random 32+ char secret: run `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Your site's URL (http://localhost:3000 locally, https://your-app.vercel.app in production)
BETTER_AUTH_URL=http://localhost:3000


# Email sending (resend.com). Without it, links are printed in the terminal (dev only).
RESEND_API_KEY=
# Must be on a domain you verified in Resend; onboarding@resend.dev only delivers to your own Resend email.
EMAIL_FROM=Velox Run Lab <noreply@yourdomain.com>
# Email verification on sign-up turns on automatically once EMAIL_FROM is on your own domain
# (with onboarding@resend.dev it stays off, since emails can't reach other users). Force it with true/false.
# REQUIRE_EMAIL_VERIFICATION=

# Google sign-in (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Owner account (gets the original run log). Created once on the next deploy/migrate; never overwritten afterwards.
# You can delete OWNER_PASSWORD from Vercel after the first deploy.
OWNER_USERNAME=pratham
OWNER_NAME=Pratham
OWNER_PASSWORD=
